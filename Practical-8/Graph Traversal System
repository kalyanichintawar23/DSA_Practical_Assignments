#include <iostream>

using namespace std;

const int MAX = 10;
int adj[MAX][MAX];
int n;

void findShortestPathBFS(int start, int destination) {
    bool visited[MAX] = {false};
    int parent[MAX];
    for (int i = 0; i < MAX; i++) {
        parent[i] = -1;
    }

    int queue[MAX];
    int front = 0;
    int rear = 0;

    visited[start] = true;
    queue[rear++] = start;

    bool found = false;

    while (front < rear) {
        int current = queue[front++];

        if (current == destination) {
            found = true;
            break;
        }

        for (int i = 0; i < n; i++) {
            if (adj[current][i] == 1 && !visited[i]) {
                visited[i] = true;
                parent[i] = current;
                queue[rear++] = i;
            }
        }
    }

    if (!found) {
        cout << "No route found using BFS." << endl;
        return;
    }

    int path[MAX];
    int pathLength = 0;

    for (int at = destination; at != -1; at = parent[at]) {
        path[pathLength++] = at;
    }

    cout << "Shortest route (BFS): ";
    for (int i = pathLength - 1; i >= 0; i--) {
        cout << path[i];
        if (i > 0) {
            cout << " -> ";
        }
    }
    cout << endl;
}

void findAllRoutesDFS(int current, int destination, bool visited[], int path[], int pathIndex) {
    visited[current] = true;
    path[pathIndex] = current;
    pathIndex++;

    if (current == destination) {
        for (int i = 0; i < pathIndex; i++) {
            cout << path[i];
            if (i < pathIndex - 1) {
                cout << " -> ";
            }
        }
        cout << endl;
    } else {
        for (int i = 0; i < n; i++) {
            if (adj[current][i] == 1 && !visited[i]) {
                findAllRoutesDFS(i, destination, visited, path, pathIndex);
            }
        }
    }

    visited[current] = false;
}

int main() {
    n = 5;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            adj[i][j] = 0;
        }
    }

    int edges[][2] = {
        {0, 1},
        {0, 2},
        {1, 2},
        {1, 3},
        {2, 4},
        {3, 4}
    };
    int totalEdges = 6;

    for (int i = 0; i < totalEdges; i++) {
        int u = edges[i][0];
        int v = edges[i][1];
        adj[u][v] = 1;
        adj[v][u] = 1;
    }

    int source = 0;
    int destination = 4;

    cout << "Delivery from " << source << " to " << destination << endl << endl;

    findShortestPathBFS(source, destination);

    cout << "\nAll possible routes (DFS):" << endl;
    bool visited[MAX] = {false};
    int path[MAX];
    findAllRoutesDFS(source, destination, visited, path, 0);

    return 0;
}
